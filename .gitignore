# Python
__pycache__/
*.pyc
.pytest_cache/

# Build artifacts (PyInstaller)
build/
dist/
*.spec.bak

# Local archive of work files (kept offline, not published)
_archive/

# Personal runtime data (user's real characters / settings - NOT published)
config.json
*.log

# Generated sequence directories (output from the GUI)
*_seq/
*_30f/
*_60f/
*_blink_*/
*_normal_*/
*_talk_*/
timing_output/
wav/
*.wav

# Test/temp files
Test.txt
test.psd
test.xcf
test_*.py
debug_*.py
check_*.py

# Generated images
*.png

# Guide screenshots bundled into the exe (keep for reproducible build)
!step1.png
!step2.png
!step3.png
!step4.png

# Document references and working media
*.docx
*.md
*.txt
*.psd
*.xcf

# (keep published docs/fixtures even though they match the broad patterns above)
!README.md
!requirements.txt
!tests/
!tests/*.py

# IDE/OS
.DS_Store
Thumbs.db